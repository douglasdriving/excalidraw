// Cloudflare Workers static-assets deploy of the excalidraw.com app.
// Workers Builds runs `yarn build:app:docker && yarn build:version`, then
// `npx wrangler deploy` uploads excalidraw-app/build.
{
  "name": "excalidraw-fork",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./excalidraw-app/build",
    "not_found_handling": "single-page-application",
  },
}
